# ReferTRM Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE (SQLite - Already Configured)
# ===========================================
DATABASE_URL=file:./dev.db

# ===========================================
# FIREBASE CONFIGURATION (Required for Real Auth)
# ===========================================
# Get these values from Firebase Console > Project Settings > Your Apps
# See FIREBASE_CONSOLE_SETUP.md for detailed instructions

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ===========================================
# OPTIONAL: Google Analytics
# ===========================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===========================================
# OPTIONAL: Payment Gateway (Future)
# ===========================================
# KBZ_PAY_MERCHANT_ID=
# KBZ_PAY_SECRET_KEY=
# WAVE_MONEY_MERCHANT_ID=
# WAVE_MONEY_SECRET_KEY=

# ===========================================
# NOTES
# ===========================================
# 1. Without Firebase config, the app runs in DEMO MODE (localStorage only)
# 2. With Firebase config, the app uses REAL AUTH & FIRESTORE
# 3. Never commit .env.local to git (it's in .gitignore)
